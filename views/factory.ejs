<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= factory.name %> · Дигитален дневник</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <a href="/" class="brand"><span class="dot"></span>ДИГИТАЛЕН ДНЕВНИК</a>
    <nav>
      <a href="/" class="active">Заводи</a>
    </nav>
    <div class="user-info">
      <a href="/fields" title="Настройки на полета">⚙ Полета</a>
      <span class="uname"><%= username %></span>
      <a href="/logout">Изход</a>
    </div>
  </header>

  <div class="container">
    <div class="breadcrumb"><a href="/">Заводи</a> / <%= factory.name %></div>
    <h1><%= factory.name %></h1>
    <p class="muted"><%= factory.location || '' %></p>

    <div class="card">
      <div class="card-header">
        <h2 class="plain" style="margin:0;">Нова машина</h2>
        <a href="/fields" class="muted" style="font-size:12px;">+ управление на полета</a>
      </div>
      <form method="POST" action="/factories/<%= factory.id %>/machines">
        <div class="form-grid">
          <div class="field">
            <label>Име на машината<span class="req">*</span></label>
            <input type="text" name="name" placeholder="напр. CNC фреза №3" required>
          </div>
          <div class="field">
            <label>Модел (по избор)</label>
            <input type="text" name="model" placeholder="напр. Haas VF-2">
          </div>
          <div class="field">
            <label>Сериен номер (по избор)</label>
            <input type="text" name="serial_number" placeholder="напр. SN-12345">
          </div>
          <% (machineFieldDefs || []).forEach(f => { %>
            <div class="field">
              <label><%= f.label %><% if (f.required) { %><span class="req">*</span><% } %></label>
              <% if (f.field_type === 'textarea') { %>
                <textarea name="cf_<%= f.key %>" <%= f.required ? 'required' : '' %>></textarea>
              <% } else if (f.field_type === 'select') { %>
                <select name="cf_<%= f.key %>" <%= f.required ? 'required' : '' %>>
                  <option value="">— избери —</option>
                  <% (f.options || []).forEach(opt => { %>
                    <option value="<%= opt %>"><%= opt %></option>
                  <% }) %>
                </select>
              <% } else { %>
                <input type="<%= f.field_type === 'number' ? 'number' : (f.field_type === 'date' ? 'date' : 'text') %>"
                       <%- f.field_type === 'number' ? 'step="any"' : '' %>
                       name="cf_<%= f.key %>" <%= f.required ? 'required' : '' %>>
              <% } %>
            </div>
          <% }) %>
        </div>
        <button type="submit">+ Добави машина</button>
      </form>
    </div>

    <h2>Машини (<%= machines.length %>)</h2>
    <% if (machines.length === 0) { %>
      <div class="card"><div class="empty">Все още няма добавени машини в този завод.</div></div>
    <% } else { %>
      <div class="card" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Машина</th>
              <th>Модел / сериен №</th>
              <th>Статус</th>
            </tr>
          </thead>
          <tbody>
            <% machines.forEach(m => { %>
              <tr>
                <td><a class="row-link" href="/machines/<%= m.id %>"><%= m.name %></a></td>
                <td class="muted"><%= m.model || '—' %><%= m.serial_number ? ' · ' + m.serial_number : '' %></td>
                <td>
                  <% if (m.last_service_date) { %>
                    <span class="badge ok">последно: <%= fmtDate(m.last_service_date) %></span>
                  <% } else { %>
                    <span class="badge warn">без обслужване</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
