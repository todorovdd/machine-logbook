<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход · Дигитален дневник</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container narrow" style="padding-top: 90px;">
    <div class="login-card">
      <div class="brand-mark">
        <span class="dot"></span>
        <span>ДИГИТАЛЕН ДНЕВНИК</span>
      </div>
      <h1>Вход</h1>
      <p class="muted" style="margin-bottom: 22px;">Администраторски панел</p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="field">
          <label>Потребителско име</label>
          <input type="text" name="username" required autofocus>
        </div>
        <div class="field">
          <label>Парола</label>
          <input type="password" name="password" required>
        </div>
        <button type="submit" style="width:100%; justify-content:center; margin-top:6px;">Вход</button>
      </form>
    </div>
  </div>
</body>
</html>
