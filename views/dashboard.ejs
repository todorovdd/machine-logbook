<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Заводи · Дигитален дневник</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <a href="/" class="brand"><span class="dot"></span>ДИГИТАЛЕН ДНЕВНИК</a>
    <nav>
      <a href="/" class="active">Заводи</a>
    </nav>
    <div class="user-info">
      <a href="/fields" title="Настройки на полета">⚙ Полета</a>
      <span class="uname"><%= username %></span>
      <a href="/logout">Изход</a>
    </div>
  </header>

  <div class="container">
    <div class="page-title-row">
      <h1>Заводи</h1>
      <img src="/images/logo.png" alt="Рагнар Ойл" class="brand-logo-inline">
    </div>
    <p class="muted">Избери завод, за да видиш машините в него, или добави нов завод.</p>

    <div class="card">
      <div class="card-header"><h2 class="plain" style="margin:0;">Нов завод</h2></div>
      <form class="inline-form" method="POST" action="/factories">
        <div class="field" style="margin-bottom:0;">
          <label>Име на завода</label>
          <input type="text" name="name" placeholder="напр. Завод Пловдив" required>
        </div>
        <div class="field" style="margin-bottom:0;">
          <label>Локация (по избор)</label>
          <input type="text" name="location" placeholder="напр. гр. Пловдив">
        </div>
        <button type="submit">+ Добави завод</button>
      </form>
    </div>

    <h2>Заводи (<%= factories.length %>)</h2>
    <% if (factories.length === 0) { %>
      <div class="card"><div class="empty">Все още няма добавени заводи.</div></div>
    <% } else { %>
      <div class="card" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Име</th>
              <th>Локация</th>
              <th class="num">Машини</th>
              <th class="actions"></th>
            </tr>
          </thead>
          <tbody>
            <% factories.forEach(f => { %>
              <tr>
                <td><a class="row-link" href="/factories/<%= f.id %>"><%= f.name %></a></td>
                <td class="muted"><%= f.location || '—' %></td>
                <td class="num"><%= f.machine_count %></td>
                <td class="actions">
                  <form method="POST" action="/factories/<%= f.id %>/delete" style="display:inline;"
                        onsubmit="return confirm('Изтриване на завода и всички машини в него?');">
                    <button type="submit" class="danger small">Изтрий</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
